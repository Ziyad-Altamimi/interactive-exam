const LECTURES=[{id:1,name:'المحاضرة الأولى',title:'مدخل إلى ريادة الأعمال',range:'3–23',description:'المفاهيم والفوائد والتحديات والسمات، وريادة الأعمال في رؤية المملكة.'},{id:2,name:'المحاضرة الثانية',title:'رعاية المشروعات الريادية وإنشاء المشروع الصغير',range:'24–48',description:'الحاضنات والمسرعات، المشروع التجاري، عوامل النجاح وخطوات الإنشاء.'},{id:3,name:'المحاضرة الثالثة',title:'رواد الأعمال: الخصائص، ودورهم الاقتصادي والاجتماعي، ومدارس رواد الأعمال',range:'49–67',description:'الفصل الثالث، ثم تنمية الإبداع والتفكير ومستوياته ضمن النطاق المطلوب.'}];
const KEY='entrepreneurship-educ125-v1';
const app=document.getElementById('app');
let state={version:1,theme:'light',tests:{}},view='home',active=null,lectureId=null,resultAttempt=null,pending=null;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nums=n=>String(n);
function warning(){document.getElementById('storage-warning').style.display='block'}
try{const saved=localStorage.getItem(KEY);if(saved){const s=JSON.parse(saved);if(s.version!==1||!s.tests||typeof s.tests!=='object')throw Error('invalid');state=s}}catch(e){warning()}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){warning()}}
function applyTheme(){document.body.classList.toggle('dark',state.theme==='dark');const dark=state.theme==='dark';document.getElementById('theme').textContent=dark?'الوضع النهاري':'الوضع الليلي';document.getElementById('theme').setAttribute('aria-label',dark?'تفعيل الوضع النهاري':'تفعيل الوضع الليلي')}
function record(id){return state.tests[id]||(state.tests[id]={history:[],current:null})}
const testById=id=>TESTS.find(t=>t.id===id);
const lectureById=id=>LECTURES.find(l=>l.id===id);
const allHistory=tests=>tests.flatMap(t=>record(t.id).history);
const average=hs=>hs.length?Math.round(hs.reduce((s,a)=>s+a.score,0)/hs.length*10):null;
const pct=n=>n===null?'—':nums(n)+'%';
const completed=tests=>tests.filter(t=>record(t.id).history.length).length;
const confirmed=a=>a?Object.keys(a.answers).length:0;
function progress(tests){return Math.round(tests.reduce((s,t)=>{const r=record(t.id);return s+(r.history.length?10:confirmed(r.current))},0)/(tests.length*10)*100)}
function bar(p){return `<div class="bar" role="progressbar" aria-label="نسبة الإنجاز" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${p}"><span style="width:${p}%"></span></div>`}
function setContent(html,preserve=false){app.innerHTML=html;app.classList.remove('enter');void app.offsetWidth;app.classList.add('enter');if(!preserve){const h=app.querySelector('h1');if(h){h.tabIndex=-1;h.focus({preventScroll:true})}window.scrollTo(0,0)}}
function source(q){return `المصدر: ${q.slides.length>1?'السلايدات':'السلايد'} ${q.slides.join('، ')} · ${esc(q.topic)}`}
function renderHome(){view='home';active=null;const done=completed(TESTS),p=progress(TESTS);setContent(`<section class="hero"><div><div class="eyebrow">مراجعتك تبدأ بخطوة</div><h1>منصة اختبارات ريادة الأعمال</h1><p class="muted">استعد للاختبار النصفي واختبر معلوماتك</p><p class="small muted">12 اختبارًا · 120 سؤالًا من محاضراتك · تعلم من كل إجابة</p></div><div class="hero-art" aria-hidden="true">▥</div></section><section class="grid stats" aria-label="إحصاءاتك"><div class="stat"><span>إجمالي الاختبارات</span><strong>12</strong></div><div class="stat"><span>الاختبارات المكتملة</span><strong><bdi>${done}/12</bdi></strong></div><div class="stat"><span>متوسط جميع المحاولات</span><strong>${pct(average(allHistory(TESTS)))}</strong></div><div class="stat"><span>التقدم الإجمالي</span><strong>${pct(p)}</strong></div></section><div class="section-head"><h2>محاضراتك</h2><span class="badge">اختر أي اختبار لتبدأ</span></div><section class="grid lectures">${LECTURES.map((l,i)=>{const ts=TESTS.filter(t=>t.lecture===l.id),lp=progress(ts);return `<article class="card lecture"><div class="row"><div class="lecture-icon" aria-hidden="true">${['◇','▱','✧'][i]}</div><span class="badge">${l.name}</span></div><h3>${l.title}</h3><p class="muted small">${l.description}</p><p class="small muted">السلايدات ${l.range} · ${ts.length} اختبارات</p><div class="row small"><span>الإنجاز</span><strong>${pct(lp)}</strong></div>${bar(lp)}<div class="row small muted"><span>${completed(ts)} من ${ts.length} مكتمل</span><span>المتوسط ${pct(average(allHistory(ts)))}</span></div><button class="secondary" data-action="lecture" data-id="${l.id}">عرض الاختبارات ←</button></article>`}).join('')}</section>${notes()}<div class="section-head"><p class="muted small">متوسط الدرجات يشمل المحاولات المكتملة. التقدم يحتسب الاختبار المكتمل أو الإجابات المؤكدة في أول محاولة.</p><button class="ghost danger" data-action="reset">إعادة ضبط التقدم</button></div>`)}
function notes(){return `<details class="source-note"><summary>حول المحتوى والمصدر وطريقة الاستخدام</summary><p>المصدر الوحيد: ملف محاضرات ريادة الأعمال المرفق. روجعت السلايدات 1–67 نصيًا وبصريًا، ولم تستخدم معلومات من خارج النطاق. السلايدان 1 و2 تمهيديان ولم تُنشأ منهما أسئلة.</p><p>التقسيم: الأولى 3–23؛ الثانية 24–48 وتشمل أسئلة التغذية الراجعة؛ الثالثة 49–67. يبدأ السلايد 49 بعنوان «الفصل الثالث: رواد الأعمال: الخصائص، ودورهم الاقتصادي والاجتماعي، ومدارس رواد الأعمال». لم يُسمَّ صراحة «المحاضرة الثالثة»؛ اعتمد عنوان الفصل بدايةً للمحاضرة الثالثة المطلوبة، وضم إليه موضوع تنمية الإبداع الذي يبدأ في 62 ضمن النطاق المحدد.</p><p>عنوان بطاقة المحاضرة الثانية تلخيص لمحاورها في 24؛ وعنوان الثالثة من عنوان الفصل في 49. جميع المراجع أرقام السلايدات المطبوعة، وهي مطابقة لترتيب صفحات الملف في هذا النطاق.</p><p>تنبيه مصدر: السلايد 28 يذكر مدة 3–4 أشهر للمسرعات تحت «مجال الاهتمام»، والسلايد 31 يذكر 3–9 أشهر تحت «مدة الدعم». لم نوحّد الرقمين؛ يُحدد السلايد في كل سؤال متعلق بهما. الأرقام والأهداف والتقديرات التاريخية تُعرض بحسب المادة ولا تمثل تحديثًا للوضع الحالي.</p><p>استُبعدت الأسئلة المفتوحة دون إجابات صريحة، ولم تُختبر الكلمات غير الواضحة. يظهر التصحيح بعد «تحقق من الإجابة» وتُثبت الإجابة عندها. لكل اختبار 6 اختياري و4 صح وخطأ؛ 3 سهلة و5 متوسطة و2 صعبة؛ و6 حفظ و4 فهم. وزعت الإجابات الصحيحة في النسخة الأولى بالتساوي على مواضع الاختيار الأربعة إجمالًا.</p><p>يعاد ترتيب الأسئلة والخيارات في كل إعادة مع الحفاظ على الإجابة الصحيحة. يحفظ المتصفح النتائج والمحاولات غير المكتملة محليًا. استخدم الملف نفسه والمتصفح نفسه للاستكمال؛ نقل الملف أو حذف بيانات المتصفح قد يؤثر في توفر التخزين المحلي.</p></details>`}
function renderLecture(id){lectureId=id;view='lecture';active=null;const l=lectureById(id),ts=TESTS.filter(t=>t.lecture===id);setContent(`<div class="eyebrow">${l.name} · السلايدات ${l.range}</div><h1>${l.title}</h1><p class="muted">اختبارات مستقلة؛ يمكنك البدء بأي اختبار. تحتوي جميعها على مزيج من الأسئلة السهلة والمتوسطة والصعبة.</p><div class="section-head"><h2>اختر اختبارك</h2><button class="ghost" data-action="home">العودة إلى اللوحة</button></div><section class="grid test-grid">${ts.map(t=>{const r=record(t.id),last=r.history.at(-1);return `<article class="card"><div class="row"><span class="test-num">الاختبار ${t.number}</span><span class="status">${r.current?'قيد التقدم':last?'مكتمل':'لم يبدأ'}</span></div><h3>${t.title}</h3><p class="small muted">10 أسئلة · 6 اختياري و4 صح وخطأ</p><p class="small muted">صعوبة متدرجة · حفظ وفهم</p>${r.current?`<p class="small">${confirmed(r.current)} من 10 إجابات مؤكدة</p>${bar(confirmed(r.current)*10)}`:''}${last?`<div class="row small"><span>آخر درجة: ${last.score}/10</span><span>الأفضل: ${Math.max(...r.history.map(a=>a.score))}/10</span></div><p class="small muted">المتوسط ${pct(average(r.history))} · ${r.history.length} محاولة</p>`:'<p class="small muted">خطوة جديدة نحو استعداد أفضل</p>'}<button data-action="start" data-id="${t.id}">${r.current?'متابعة':last?'إعادة الاختبار':'ابدأ الاختبار'}</button>${last?`<button class="secondary" data-action="result" data-id="${t.id}">النتيجة وسجل المحاولات</button>`:''}</article>`}).join('')}</section>${notes()}`)}
function shuffle(list){const a=[...list];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function newAttempt(t,retry){let order=t.questions.map(q=>q.id);if(retry){order=shuffle(order);if(order.every((id,i)=>id===record(t.id).history.at(-1)?.order[i]))order.push(order.shift())}const previous=record(t.id).history.at(-1);const options={};for(const q of t.questions){let o=q.options.map((_,i)=>i);if(retry){o=shuffle(o);if(o.every((v,i)=>v===previous?.options[q.id]?.[i]))o.push(o.shift())}options[q.id]=o}return {id:Date.now().toString(36)+Math.random().toString(36).slice(2,7),started:new Date().toISOString(),order,options,answers:{},drafts:{},index:0}}
function start(id){const t=testById(id),r=record(id);if(!r.current)r.current=newAttempt(t,r.history.length>0);active=id;lectureId=t.lecture;view='exam';save();renderExam()}
function questionContext(){const t=testById(active),a=record(active).current,q=t.questions.find(q=>q.id===a.order[a.index]);return {t,a,q}}
function feedback(q,answer){const ok=answer.choice===q.correct;return `<div class="feedback ${ok?'good':'bad'}" role="status"><strong>${ok?'✓ إجابة صحيحة':'✕ إجابة خاطئة'}</strong>${!ok?`<p>اختيارك: ${esc(q.options[answer.choice])}<br><strong>الإجابة الصحيحة: ${esc(q.options[q.correct])}</strong></p>`:''}<p>${esc(ok?q.explanation:q.wrongExplanation)}</p><small>${source(q)}</small></div>`}
function renderExam(preserve=false){view='exam';const {t,a,q}=questionContext(),ans=a.answers[q.id],selected=ans?ans.choice:a.drafts[q.id],l=lectureById(t.lecture),count=confirmed(a);setContent(`<div class="exam"><div class="exam-head"><div class="row"><span class="eyebrow">${l.name} · الاختبار ${t.number}</span><button class="ghost small" data-action="lecture" data-id="${l.id}">قائمة الاختبارات</button></div><h1>${t.title}</h1><div class="row small muted"><span>السؤال ${a.index+1} من 10</span><span>${count} إجابات مؤكدة · الدرجة الحالية ${Object.values(a.answers).filter(x=>x.correct).length}/10</span></div>${bar(count*10)}</div><nav class="qnav" aria-label="الانتقال بين الأسئلة">${a.order.map((id,i)=>{const v=a.answers[id];return `<button data-action="jump" data-index="${i}" class="${i===a.index?'current ':''}${v?(v.correct?'right':'wrong'):''}" aria-label="السؤال ${i+1}، ${v?(v.correct?'إجابة صحيحة':'إجابة خاطئة'):'غير مؤكد'}" ${i===a.index?'aria-current="step"':''}>${i+1}${v?(v.correct?' ✓':' ✕'):''}</button>`}).join('')}</nav><p class="legend"><span>✓ صحيح</span><span>✕ خاطئ</span><span>رقم فقط: غير مؤكد</span><span>الإطار: السؤال الحالي</span></p><section class="card"><div class="qmeta"><span class="badge">${q.type==='mcq'?'اختيار من متعدد':'صح أو خطأ'}</span><span class="badge">${q.difficulty}</span><span class="badge">${q.objective==='حفظ'?'حفظ واسترجاع':'فهم وتطبيق'}</span></div><h2 class="question" id="question-text">${esc(q.prompt)}</h2><div class="options" role="group" aria-labelledby="question-text">${a.options[q.id].map((oi,i)=>`<button class="option ${selected===oi?'selected ':''}${ans?(oi===q.correct?'correct':oi===ans.choice?'incorrect':''):''}" data-action="select" data-choice="${oi}" aria-pressed="${selected===oi}" ${ans?'disabled':''}><span class="letter" aria-hidden="true">${q.type==='mcq'?['أ','ب','ج','د'][i]:(oi===0?'✓':'✕')}</span><span>${esc(q.options[oi])}</span>${ans&&oi===q.correct?'<span aria-label="الإجابة الصحيحة">✓</span>':''}</button>`).join('')}</div>${ans?feedback(q,ans):'<p class="small muted" style="margin-top:18px">اختر إجابة ثم تحقق منها. ستُثبت بعد التحقق ضمن هذه المحاولة.</p>'}<div class="actions"><button data-action="check" ${ans||selected===undefined?'disabled':''}>${ans?'تم التحقق':'تحقق من الإجابة'}</button><button class="ghost" data-action="prev" ${a.index===0?'disabled':''}>السؤال السابق</button><button class="secondary push" data-action="next" ${a.index===9?'disabled':''}>السؤال التالي</button>${count===10?'<button data-action="finish">عرض النتائج</button>':''}</div></section><p class="small muted">يحفظ تقدمك بعد كل اختيار وتحقق وانتقال. يمكنك العودة إلى لوحة التحكم في أي وقت.</p></div>`,preserve)}
function select(choice){const {a,q}=questionContext();if(a.answers[q.id])return;a.drafts[q.id]=choice;save();renderExam(true)}
function check(){const {a,q}=questionContext();const choice=a.drafts[q.id];if(choice===undefined||a.answers[q.id])return;a.answers[q.id]={choice,correct:choice===q.correct};save();renderExam(true)}
function jump(index){const {a}=questionContext();a.index=Math.max(0,Math.min(9,index));save();renderExam()}
function finish(){const r=record(active),a=r.current;if(confirmed(a)!==10)return;a.score=Object.values(a.answers).filter(x=>x.correct).length;a.finished=new Date().toISOString();r.history.push(a);r.current=null;save();renderResult(active,a.id)}
function renderResult(id,attemptId){active=id;view='result';const t=testById(id),r=record(id),a=r.history.find(a=>a.id===attemptId)||r.history.at(-1);if(!a)return renderLecture(t.lecture);resultAttempt=a.id;const wrong=t.questions.filter(q=>!a.answers[q.id].correct);function metric(label,qs){const right=qs.filter(q=>a.answers[q.id].correct).length;return `<div class="metric-line"><span>${label}</span><strong>${right}/${qs.length} · ${pct(Math.round(right/qs.length*100))}</strong></div>${bar(Math.round(right/qs.length*100))}`}setContent(`<div class="exam"><div class="eyebrow">${lectureById(t.lecture).name} · الاختبار ${t.number}</div><h1>نتيجتك: ${t.title}</h1><section class="card center"><div class="score-ring"><strong>${a.score}/10</strong><span>${pct(a.score*10)}</span></div><h2>${a.score>=8?'أداء مميز، واصل تقدمك':a.score>=5?'خطوة جيدة، راجع ما فاتك':'كل مراجعة تقربك من الإتقان'}</h2><p class="muted">${a.score} صحيحة · ${10-a.score} خاطئة</p><p class="small muted">أفضل درجة: ${Math.max(...r.history.map(h=>h.score))}/10 · متوسط المحاولات ${pct(average(r.history))}</p><div class="actions" style="justify-content:center"><button data-action="retry" data-id="${id}">إعادة الاختبار</button><button class="secondary" data-action="lecture" data-id="${t.lecture}">اختبارات المحاضرة</button></div></section><div class="grid metrics"><section class="card"><h2>الأداء حسب الهدف</h2>${metric('الحفظ',t.questions.filter(q=>q.objective==='حفظ'))}${metric('الفهم',t.questions.filter(q=>q.objective==='فهم'))}</section><section class="card"><h2>الأداء حسب الصعوبة</h2>${['سهل','متوسط','صعب'].map(d=>metric(d,t.questions.filter(q=>q.difficulty===d))).join('')}</section></div><div class="section-head"><h2>مراجعة أخطائي</h2><span class="badge">${wrong.length} أسئلة</span></div>${wrong.length?wrong.map(q=>`<article class="card review"><span class="badge">${esc(q.topic)}</span><h3>${esc(q.prompt)}</h3><p class="your small">إجابتك السابقة: ${esc(q.options[a.answers[q.id].choice])}</p><p class="correct-text small"><strong>الإجابة الصحيحة: ${esc(q.options[q.correct])}</strong></p><p>${esc(q.wrongExplanation)}</p><p class="small muted">${source(q)}</p></article>`).join(''):'<div class="card empty">✓ أجبت عن جميع الأسئلة بشكل صحيح في هذه المحاولة.</div>'}<section class="card" style="margin-top:25px"><h2>سجل النتائج السابقة</h2><p class="small muted">المحاولة المعروضة مميزة في السجل. لا تمسح إعادة الاختبار نتائجك أو أفضل درجة.</p><div class="history">${r.history.map((h,i)=>`<div class="history-item"><span>المحاولة ${i+1} · ${new Date(h.finished).toLocaleDateString('ar-SA-u-ca-gregory-nu-latn')}<br><strong>${h.score}/10 · ${pct(h.score*10)}</strong></span><button class="${h.id===a.id?'secondary':'ghost'} small" data-action="history" data-id="${id}" data-attempt="${h.id}" ${h.id===a.id?'disabled':''}>${h.id===a.id?'معروضة الآن':'عرض التفاصيل'}</button></div>`).reverse().join('')}</div></section></div>`)}
function ask(title,message,label,callback){const d=document.getElementById('confirm');document.getElementById('dialog-title').textContent=title;document.getElementById('dialog-text').textContent=message;document.getElementById('dialog-yes').textContent=label;pending=callback;d.showModal();document.getElementById('dialog-no').focus()}
function retry(id){const r=record(id);const begin=()=>{r.current=newAttempt(testById(id),true);save();start(id)};if(r.current)ask('توجد محاولة غير مكتملة','بدء محاولة جديدة سيستبدل المحاولة غير المكتملة فقط. ستبقى جميع النتائج المكتملة وأفضل درجة محفوظة.','بدء محاولة جديدة',begin);else begin()}
app.addEventListener('click',e=>{const b=e.target.closest('button[data-action]');if(!b||b.disabled)return;const id=b.dataset.id;switch(b.dataset.action){case'home':renderHome();break;case'lecture':renderLecture(Number(id));break;case'start':start(id);break;case'select':select(Number(b.dataset.choice));break;case'check':check();break;case'jump':jump(Number(b.dataset.index));break;case'next':jump(questionContext().a.index+1);break;case'prev':jump(questionContext().a.index-1);break;case'finish':finish();break;case'result':renderResult(id);break;case'history':renderResult(id,b.dataset.attempt);break;case'retry':retry(id);break;case'reset':ask('إعادة ضبط التقدم بالكامل؟','ستحذف جميع المحاولات والدرجات وأفضل النتائج والإجابات المحفوظة على هذا المتصفح. لا يمكن التراجع عن الحذف.','حذف التقدم',()=>{state.tests={};save();renderHome()});break}});
document.getElementById('home').onclick=renderHome;
document.getElementById('theme').onclick=()=>{state.theme=state.theme==='dark'?'light':'dark';applyTheme();save()};
document.getElementById('dialog-no').onclick=()=>{pending=null;document.getElementById('confirm').close()};
document.getElementById('dialog-yes').onclick=()=>{const f=pending;pending=null;document.getElementById('confirm').close();if(f)f()};
document.getElementById('confirm').addEventListener('cancel',()=>pending=null);
applyTheme();renderHome();
</script></body></html>
